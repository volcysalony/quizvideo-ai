# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# QuizVideo AI - local storage
/storage/images/*
/storage/audio/*
/storage/music/*
/storage/effects/*
/storage/renders/*
/storage/temp/*

# Keep folders
!/storage/images/.gitkeep
!/storage/audio/.gitkeep
!/storage/music/.gitkeep
!/storage/effects/.gitkeep
!/storage/renders/.gitkeep
!/storage/temp/.gitkeep

# Local AI / editor tooling
.agents/
.claude/
.windsurf/

# Optional local agent files
AGENTS.md
CLAUDE.md
skills-lock.json

# Local SQLite database
/dev.db
/prisma/dev.db
*.db-journal
*.db-shm
*.db-wal

# Generated uploads
/public/uploads/questions/*
!/public/uploads/questions/.gitkeep