generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id    String @id @default(cuid())
  title String

  format String @default("VERTICAL")

  width  Int @default(1080)
  height Int @default(1920)
  fps    Int @default(30)

  introSeconds     Float @default(1)
  countdownSeconds Float @default(6)
  revealSeconds    Float @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
  renders   Render[]
}

model Question {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  text String

  imagePath String?

  // Enquadramento da imagem principal
  imageFit       String @default("CONTAIN")
  imagePositionX Float  @default(50)
  imagePositionY Float  @default(50)
  imageScale     Float  @default(1)

  // TEXT | IMAGE | IMAGE_TEXT
  answerMode String @default("TEXT")

  correctAnswer Int

  backgroundColor String @default("#9333EA")

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options Option[]

  @@unique([projectId, position])
  @@index([projectId])
}

model Option {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text String

  imagePath String?

  // Enquadramento da imagem da alternativa
  imageFit       String @default("COVER")
  imagePositionX Float  @default(50)
  imagePositionY Float  @default(50)
  imageScale     Float  @default(1)

  position Int

  @@unique([questionId, position])
  @@index([questionId])
}

model Render {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status String @default("PENDING")

  progress Int @default(0)

  outputPath String?

  errorMessage String?

  createdAt DateTime @default(now())

  startedAt   DateTime?
  completedAt DateTime?

  @@index([projectId])
}
